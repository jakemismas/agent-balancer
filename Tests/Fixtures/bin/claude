#!/bin/sh
# Fake claude for tests. Its behavior comes from files under $HOME/.ab-fake, written by the test.
dir="$HOME/.ab-fake"
mkdir -p "$dir"
printf '%s\n' "$*" >> "$dir/args.log"
env | cut -d= -f1 | sort > "$dir/env-names.txt"
env | sort >> "$dir/env-full.txt"
printf '%s\n' "${CLAUDE_CONFIG_DIR-unset}" > "$dir/config-dir.txt"
printf '%s\n' "${CLAUDE_CONFIG_DIR-unset}" >> "$dir/config-dirs.log"

# A sign-in the test staged: it takes effect when the fake is started for an interactive launch or
# for `auth login`, the two ways a person signs in.
sign_in() {
  if [ -f "$dir/auth-after-sign-in.json" ]; then cp "$dir/auth-after-sign-in.json" "$dir/auth.json"; fi
  # A change the test staged to happen while the person signs in, such as an edit of the config.
  if [ -f "$dir/during-sign-in.sh" ]; then sh "$dir/during-sign-in.sh"; fi
}

# A probe's start and end, appended in the order they happen, so a test can tell which probes
# ran at the same time. A token account probe is named by its token file, any other by its pid.
if [ "$1" = "-p" ]; then
  span="$$"
  prev=""
  for a in "$@"; do
    if [ "$prev" = "--settings" ]; then span="$(basename "$a" .json)"; fi
    prev="$a"
  done
  printf 'start %s\n' "$span" >> "$dir/spans.log"
  trap 'printf "end %s\n" "$span" >> "$dir/spans.log"' EXIT
fi

if [ -f "$dir/delay" ]; then sleep "$(cat "$dir/delay")"; fi
if [ -f "$dir/stderr.txt" ]; then cat "$dir/stderr.txt" >&2; fi

case "$1" in
  --version)
    if [ -f "$dir/version.txt" ]; then cat "$dir/version.txt"; else echo "2.1.0 (Claude Code)"; fi
    exit 0
    ;;
  --help)
    echo "Usage: claude [options] [command]"
    exit 0
    ;;
  setup-token)
    if [ -f "$dir/setup-token.out" ]; then cat "$dir/setup-token.out"; fi
    if [ -f "$dir/setup-token.err" ]; then cat "$dir/setup-token.err" >&2; fi
    if [ -f "$dir/setup-token.exit" ]; then exit "$(cat "$dir/setup-token.exit")"; fi
    exit 0
    ;;
  auth)
    if [ "$2" = "login" ]; then
      # A sign-in the test makes fail ends with that status and signs nothing in.
      if [ -f "$dir/auth-login.exit" ]; then exit "$(cat "$dir/auth-login.exit")"; fi
      sign_in
      exit 0
    fi
    # A check of the default folder reads its own answer when a test staged one, so a login
    # account and a folder account can each be signed in at once.
    if [ -z "${CLAUDE_CONFIG_DIR+set}" ] && [ -f "$dir/auth-default.json" ]; then
      cat "$dir/auth-default.json"
    elif [ -f "$dir/auth.json" ]; then
      cat "$dir/auth.json"
    fi
    if [ -f "$dir/auth.exit" ]; then exit "$(cat "$dir/auth.exit")"; fi
    exit 0
    ;;
  -p)
    model=""
    settings=""
    prev=""
    for a in "$@"; do
      if [ "$prev" = "--model" ]; then model="$a"; fi
      if [ "$prev" = "--settings" ]; then settings="$a"; fi
      prev="$a"
    done
    # A token account probe names its token file; a per-account stream can answer it.
    acct=""
    if [ -n "$settings" ]; then acct="$(basename "$settings" .json)"; fi
    pwd >> "$dir/cwd.log"
    stat -f %Lp . >> "$dir/cwd-mode.log"
    printf '%s\n' "$model" >> "$dir/models.log"
    # A probe of an account the test holds says so and waits until the test lets it go, at most
    # five minutes, so the test can order another command around it.
    if [ -n "$acct" ] && [ -f "$dir/hold-$acct" ]; then
      : > "$dir/held-$acct"
      n=0
      while [ ! -f "$dir/go-$acct" ] && [ "$n" -lt 3000 ]; do sleep 0.1; n=$((n + 1)); done
    fi
    # A probe with one model can take longer than the others.
    if [ -f "$dir/delay-$model" ]; then sleep "$(cat "$dir/delay-$model")"; fi
    if [ -f "$dir/unknown-option" ]; then
      echo "error: unknown option '--safe-mode'" >&2
      exit 1
    fi
    # A stream picked by the token the settings file holds, so a test can swap a token file.
    bytoken=""
    if [ -n "$settings" ]; then
      for f in "$dir"/token-stream-*.token; do
        [ -f "$f" ] || continue
        if grep -qF -- "$(cat "$f")" "$settings" 2>/dev/null; then bytoken="${f%.token}.jsonl"; fi
      done
    fi
    if [ -n "$bytoken" ] && [ -f "$bytoken" ]; then
      cat "$bytoken"
    elif [ -n "$acct" ] && [ -f "$dir/probe-for-$acct.jsonl" ]; then
      cat "$dir/probe-for-$acct.jsonl"
    elif [ -f "$dir/probe-$model.jsonl" ]; then
      cat "$dir/probe-$model.jsonl"
    elif [ -f "$dir/probe.jsonl" ]; then
      cat "$dir/probe.jsonl"
    elif [ -f "$dir/probe.json" ]; then
      cat "$dir/probe.json"
    fi
    if [ -f "$dir/probe.exit" ]; then exit "$(cat "$dir/probe.exit")"; fi
    exit 0
    ;;
esac
# An interactive launch: any other arguments end with the status a test chose, 2 by default.
sign_in
if [ -f "$dir/default.exit" ]; then exit "$(cat "$dir/default.exit")"; fi
exit 2
